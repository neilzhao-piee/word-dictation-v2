# /etc/wd-ocr.env — environment for scripts/wd-ocr.service (root 0600 in production).
# Copy to /etc/wd-ocr.env, fill in, then: systemctl restart wd-ocr
# Never commit the filled-in file: it holds a billable Azure key.

# Azure AI Vision (Read) resource. Portal > your resource > Keys and Endpoint.
WD_OCR_KEY=
WD_OCR_ENDPOINT=https://<region>.api.cognitive.microsoft.com

# Optional shared secret for POST /ocr (X-WD-Token header). Leave empty for a
# LAN-only relay; set it whenever the relay is reachable from the internet.
# Generate one with: openssl rand -hex 16
WD_OCR_TOKEN=

# Listen port (default 8093). Keep it bound to localhost/your LAN, and put a
# reverse tunnel (Cloudflare Tunnel / Tailscale Funnel) in front for public HTTPS.
WD_OCR_PORT=8093

# Optional recognition language, e.g. en. Omit to let Azure auto-detect.
# WD_OCR_LANGUAGE=en
